# ── Python ─────────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*$py.class
*.pyc
.pytest_cache/
.mypy_cache/

# ── IDE ────────────────────────────────────────────────────────────────────────
.idea/
.vscode/

# ── Build artifacts ────────────────────────────────────────────────────────────
*.egg-info/
dist/
build/

# ── ВКР-материалы: документы, презентации, дампы (не часть кода) ──────────────
_materials/

# ── App runtime outputs (generated data, images, reports) ─────────────────────
output/
extracted_images/

# ── Large / binary data files ──────────────────────────────────────────────────
*.csv
*.xlsx
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.pdf
*.docx
*.pptx

# Data JSON files (but NOT config files like vercel.json)
data/*.json

# ── Logs & temp text dumps ─────────────────────────────────────────────────────
*.log
*.txt
!requirements.txt
!runtime.txt
!api/requirements.txt

# ── Data files ─────────────────────────────────────────────────────────────────
data/

# ── Helper/patch scripts (not part of project) ─────────────────────────────────
patch_mobile.py
